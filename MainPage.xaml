<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StudentPerformanceAnalyzer.Models"
             xmlns:viewmodels="clr-namespace:StudentPerformanceAnalyzer.ViewModels"
             x:Class="StudentPerformanceAnalyzer.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Аналізатор успішності студентів (XML)">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20" RowSpacing="15">

        <Border Grid.Row="0" StrokeThickness="1" Stroke="#CCCCCC" Padding="15" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Факультет:" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Faculties}"
                            SelectedItem="{Binding SelectedFaculty}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Кафедра:" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Departments}"
                            SelectedItem="{Binding SelectedDepartment}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="5">
                    <Label Text="Курс:" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding Courses}"
                            SelectedItem="{Binding SelectedCourse}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="5">
                    <Label Text="Метод аналізу (Стратегія):" FontAttributes="Bold" />
                    <Picker ItemsSource="{Binding SearchMethods}"
                            SelectedItem="{Binding SelectedMethod}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Пошук"
                    Command="{Binding SearchCommand}"
                    WidthRequest="140"
                    FontAttributes="Bold" />

            <Button Text="Clear"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White"
                    WidthRequest="120" />

            <Button Text="Експорт в HTML"
                    Command="{Binding ExportHtmlCommand}"
                    BackgroundColor="#198754"
                    TextColor="White"
                    WidthRequest="160" />
        </HorizontalStackLayout>

        <Border Grid.Row="2" BackgroundColor="#F0F4F8" StrokeThickness="0" Padding="12" StrokeShape="RoundRectangle 6">
            <Label Text="{Binding StatusMessage}"
                   TextColor="#1E293B"
                   FontAttributes="Bold" />
        </Border>

        <CollectionView Grid.Row="3" ItemsSource="{Binding SearchResults}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                    <Label Text="Немає даних для відображення. Натисніть «Пошук»."
                           TextColor="Gray"
                           FontSize="16" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <Border StrokeThickness="1" Stroke="#CBD5E1" Padding="15" Margin="0,0,0,10" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Faculty, StringFormat='Факультет: {0}'}" VerticalOptions="Center" />
                                <Label Text="{Binding Department, StringFormat='Кафедра: {0}'}" VerticalOptions="Center" />
                                <Label Text="{Binding Course, StringFormat='Курс: {0}'}" VerticalOptions="Center" />
                                <Label Text="{Binding Group, StringFormat='Група: {0}'}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Disciplines}" Spacing="4" Padding="10,0,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Discipline">
                                        <Grid ColumnDefinitions="300, 100, 120">
                                            <Label Grid.Column="0" Text="{Binding Name}" />
                                            <Label Grid.Column="1" Text="{Binding Grade, StringFormat='Бал: {0}'}" FontAttributes="Bold" />
                                            <Label Grid.Column="2" Text="{Binding Status}" TextColor="#475569" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>